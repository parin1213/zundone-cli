{
  "name": "zundone-cli",
  "version": "0.1.0",
  "description": "VOICEVOX speaking CLI with HTTP and Docker backends",
  "type": "module",
  "bin": {
    "zundone": "./dist/cli.js",
    "zd": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/which": "^3.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "env-paths": "^4.0.0",
    "execa": "^9.6.1",
    "string-argv": "^0.3.2",
    "which": "^6.0.1"
  }
}
